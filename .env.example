# Copy this file to .env.local and fill in real values.
# See SETUP.md for where to get each key.

# Firebase Web SDK config (required — client-side, safe to expose, protected by Firestore/Storage rules)
# Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional overrides for Cloud Function endpoints used by MeetX.
# Only needed if your Cloud Functions are deployed under a different
# project/region than the defaults baked into the code.
# NEXT_PUBLIC_PROCESS_MEETING_FILE_URL=
# NEXT_PUBLIC_GENERATE_MEETING_INSIGHTS_URL=

# The AI features themselves (chatbot, podcast, image gen, meeting insights)
# run as Firebase Cloud Functions, not in this Next.js app. Their secrets
# (GOOGLE_GENAI_API_KEY, OPENROUTER_API_KEY, HF_API_TOKEN) are configured
# separately via `firebase functions:secrets:set` — see SETUP.md.
